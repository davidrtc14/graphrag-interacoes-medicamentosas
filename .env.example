# Copie para .env e preencha. O arquivo .env nunca vai para o repositório.

# Neo4j local (docker-compose.yml). No Aura Free, troque a URI, o usuário e a senha.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=defina-uma-senha

# Ordem de uso dos provedores de LLM. O seguinte só entra se o anterior falhar.
# Opções: gemini, groq, ollama
LLM_PROVIDERS=gemini,groq

# Chave gratuita: https://aistudio.google.com
GEMINI_API_KEY=
# Um ou mais modelos, em ordem de preferência
GEMINI_MODEL=gemini-3.5-flash,gemini-3-flash-preview,gemini-3.1-flash-lite

# Chave gratuita: https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Opcional, para quem quiser rodar sem chave
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
